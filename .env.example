# NVH Test local deployment example
COMPOSE_PROJECT_NAME=nvhtest

# Public URLs
WEB_PUBLIC_URL=http://localhost:8080
FORUM_PUBLIC_URL=http://localhost:8081
API_PUBLIC_URL=http://localhost:8082
AI_API_PUBLIC_URL=http://localhost:8083

# Professional API mock database settings
NVH_API_DATABASE_URL=postgresql://nvh_api:nvh_api_dev@api-db:5432/nvh_api
NVH_API_REDIS_URL=redis://api-redis:6379/0
NVH_API_OBJECT_STORAGE_URL=http://minio:9000
NVH_API_KEY_PREFIX=nvh_live_

# General AI API mock database settings
AI_API_DATABASE_URL=postgresql://ai_api:ai_api_dev@ai-api-db:5432/ai_api
AI_API_REDIS_URL=redis://ai-api-redis:6379/0
AI_API_KEY_PREFIX=ai_live_

# Discourse is deployed separately through the official installer.
DISCOURSE_HOSTNAME=forum.nvhtest.cn
DISCOURSE_DEVELOPER_EMAILS=admin@nvhtest.cn
