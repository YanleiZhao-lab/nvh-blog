:root {
  --paper: #f6f4ef;
  --surface: #ffffff;
  --ink: #121212;
  --muted: #4f5964;
  --line: #9ca7b3;
  --line-soft: #d0d6dc;
  --blue: #1f4f82;
  --teal: #11645b;
  --amber: #8a5700;
  --coral: #a5402d;
  --radius: 8px;
}

* { box-sizing: border-box; }
html { color-scheme: light; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  line-height: 1.65;
}
a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
img, svg { max-width: 100%; }
:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }

.site-shell { min-height: 100vh; display: flex; flex-direction: column; }
.topbar {
  border-bottom: 1px solid var(--line);
  background: #fffdf8;
}
.topbar__inner,
.page,
.footer__inner {
  width: min(1160px, calc(100% - 32px));
  margin: 0 auto;
}
.topbar__inner {
  min-height: 66px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}
.brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
.brand__mark {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border: 1px solid var(--ink);
  border-radius: var(--radius);
  font-weight: 900;
}
.brand strong, .brand small { display: block; }
.brand small { color: var(--muted); font-size: 12px; }
.nav { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.nav a,
.button,
.chip {
  min-height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  text-decoration: none;
  font-weight: 700;
}
.nav a[aria-current="page"],
.button.primary,
.chip[aria-pressed="true"] {
  background: var(--blue);
  border-color: var(--blue);
  color: #fff;
}
.page { flex: 1; padding: 36px 0 64px; }
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr);
  gap: 28px;
  align-items: stretch;
  padding: 34px 0;
  border-bottom: 1px solid var(--line);
}
.eyebrow {
  margin: 0 0 10px;
  color: var(--blue);
  font-size: 13px;
  font-weight: 900;
  text-transform: uppercase;
}
h1, h2, h3 { line-height: 1.18; margin: 0; }
h1 { max-width: 820px; font-size: clamp(38px, 6vw, 76px); font-family: Georgia, "Times New Roman", "Microsoft YaHei", serif; }
h2 { font-size: clamp(26px, 3vw, 40px); }
h3 { font-size: 20px; }
.lead { max-width: 760px; margin: 18px 0 0; color: var(--muted); font-size: 18px; }
.hero__panel,
.card,
.article-row,
.doc-row,
.status-panel {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
}
.hero__panel { padding: 18px; display: grid; align-content: start; gap: 14px; }
.metric { display: grid; grid-template-columns: 88px 1fr; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line-soft); }
.metric:last-child { padding-bottom: 0; border-bottom: 0; }
.metric strong { color: var(--blue); }
.actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }
.section { padding: 34px 0; border-bottom: 1px solid var(--line); }
.section__head { display: flex; align-items: end; justify-content: space-between; gap: 18px; margin-bottom: 18px; }
.section__head p { margin: 8px 0 0; color: var(--muted); }
.grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
.card { padding: 18px; }
.card p { color: var(--muted); margin: 8px 0 0; }
.meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; color: var(--muted); font-size: 14px; }
.badge {
  display: inline-flex;
  padding: 2px 8px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: #fffdf8;
  color: var(--blue);
  font-size: 12px;
  font-weight: 800;
}
.layout { display: grid; grid-template-columns: 248px minmax(0, 1fr); gap: 24px; align-items: start; }
.sidebar {
  position: sticky;
  top: 16px;
  display: grid;
  gap: 10px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: #fffdf8;
}
.sidebar label { font-weight: 800; }
.search {
  min-height: 42px;
  width: 100%;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: #fff;
  color: var(--ink);
}
.feed { display: grid; gap: 12px; }
.article-row { padding: 18px; display: grid; gap: 10px; }
.article-row[hidden] { display: none; }
.article-row h2 { font-size: clamp(22px, 2.4vw, 32px); }
.article-row p { margin: 0; color: var(--muted); }
.tags { display: flex; flex-wrap: wrap; gap: 6px; }
.docs-layout { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: 18px; }
.doc-row { padding: 16px; }
.doc-row p { margin: 8px 0 0; color: var(--muted); }
.footer { margin-top: auto; border-top: 1px solid var(--line); background: #fffdf8; }
.footer__inner { padding: 20px 0; display: flex; justify-content: space-between; gap: 18px; flex-wrap: wrap; color: var(--muted); }

@media (max-width: 820px) {
  .topbar__inner, .section__head, .footer__inner { align-items: flex-start; flex-direction: column; }
  .hero, .layout, .docs-layout, .grid { grid-template-columns: 1fr; }
  .sidebar { position: static; }
  h1 { font-size: 42px; }
}
