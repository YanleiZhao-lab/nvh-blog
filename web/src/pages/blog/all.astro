---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, statusBadge } from "../../utils/blog";

// 获取所有文章，支持排序参数
const url = Astro.url;
const sortBy = url.searchParams.get("sort") || "date";
const posts = (await getCollection("blog")).sort((a, b) => {
  if (sortBy === "title") {
    return a.data.title.localeCompare(b.data.title, "zh-CN");
  }
  return b.data.date.valueOf() - a.data.date.valueOf();
});
const categories = ["全部", ...Array.from(new Set(posts.map((p) => p.data.category)))];
const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags))).sort();
---

<BaseLayout title="全部文章 | NVH Test" description="NVH Test 博客全部文章目录。" current="博客">
  <section class="section" style="padding-top: 0;">
    <div class="section__head">
      <div>
        <p class="eyebrow">全部文章</p>
        <h1>共 {posts.length} 篇文章</h1>
      </div>
      <div style="display: flex; gap: 8px;">
        <a class="chip" href="/blog/all/" aria-pressed={sortBy === "date" ? "true" : "false"}>按日期</a>
        <a class="chip" href="/blog/all/?sort=title" aria-pressed={sortBy === "title" ? "true" : "false"}>按标题</a>
        <a class="chip" href="/blog/">← 返回博客首页</a>
      </div>
    </div>

    <div class="blog-layout" data-filter-group>
      <aside class="sidebar">
        <h4>搜索</h4>
        <input class="search" type="search" placeholder="搜索文章…"" data-search aria-label="搜索" />
        <h4 style="margin-top: 16px;">分类</h4>
        {categories.map((cat) => (
          <button class="chip" type="button" data-filter={cat === "全部" ? "all" : cat} aria-pressed={cat === "全部" ? "true" : "false"}>{cat}</button>
        ))}
        <h4 style="margin-top: 16px;">标签</h4>
        <div class="tag-cloud">
          {allTags.map((tag) => <span class="badge badge--default">#{tag}</span>)}
        </div>
      </aside>

      <div class="feed">
        {posts.map((post) => (
          <article class="article-card" data-filter-card data-category={post.data.category} data-tags={post.data.tags.join(" ")}>
            <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px;">
              <span class={`badge ${statusBadge(post.data.status)}`}>{post.data.status}</span>
              <span class="badge badge--default">{post.data.category}</span>
            </div>
            <h2><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <div class="tags">
              {post.data.tags.map((tag) => <span class="badge badge--default">#{tag}</span>)}
            </div>
            <div class="article-meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span>·</span>
              <span>{post.data.author}</span>
            </div>
          </article>
        ))}
        <div data-empty-state style="display: none; text-align: center; padding: 48px; color: var(--text-muted);">
          <p>没有匹配的文章。试试其他关键词？</p>
        </div>
      </div>
    </div>
  </section>
  <script is:inline src="/assets/site.js"></script>
</BaseLayout>
