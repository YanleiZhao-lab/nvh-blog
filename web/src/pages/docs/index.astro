---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const docs = (await getCollection("docs")).sort((a, b) => a.data.title.localeCompare(b.data.title, "zh-CN"));
---
<BaseLayout title="文档知识库 | NVH Test" description="NVH Test 文档知识库：部署、站群架构、内容同步和服务边界。" current="文档">
  <section class="hero">
    <div>
      <p class="eyebrow">docs.nvhtest.cn</p>
      <h1>文档知识库架构：像工程手册一样维护站群。</h1>
      <p class="lead">先把部署、内容同步、论坛、API 边界写清楚；长期可以把现有 VitePress/Githubfeishu 内容迁入或作为上游。</p>
    </div>
    <aside class="hero__panel">
      <div class="metric"><strong>Git</strong><span>Markdown 作为第一内容源</span></div>
      <div class="metric"><strong>VitePress</strong><span>兼容现有 NVH 百宝箱内容</span></div>
    </aside>
  </section>
  <section class="section docs-layout">
    <aside class="status-panel" style="padding: 16px;">
      <h2>知识库分区</h2>
      <p>部署、架构、内容、论坛、API。每篇文档都要有状态和更新时间，避免靠聊天记录保存上下文。</p>
    </aside>
    <div class="feed">
      {docs.map((doc) => (
        <article class="doc-row">
          <span class="badge">{doc.data.status}</span>
          <h3><a href={`/docs/${doc.slug}/`}>{doc.data.title}</a></h3>
          <p>{doc.data.description}</p>
          <div class="meta"><span>{doc.data.category}</span><time datetime={doc.data.date.toISOString()}>{doc.data.date.toLocaleDateString("zh-CN")}</time></div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
